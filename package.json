{
  "name": "codex-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cyber Chess: a playable 3D browser chess game packaged for the Codex game challenge.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build",
    "desktop:stage": "npm run build && node scripts/package-desktop.mjs stage",
    "desktop:dev": "npm run desktop:stage && electron dist-desktop/stage",
    "package:music-zip": "node scripts/package-long-music.mjs",
    "package:win": "npm run build && node scripts/package-desktop.mjs package",
    "setup": "npm ci && npm run build",
    "play": "npm run setup && npm start",
    "preflight": "npm run build && npm test && npm run smoke",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "gsap": "^3.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^42.3.2",
    "playwright": "1.60.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
